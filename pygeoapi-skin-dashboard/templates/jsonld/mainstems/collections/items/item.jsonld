{
    "@context": [
        {
            "schema": "https://schema.org/",
            "gsp": "http://www.opengis.net/ont/geosparql#",
            "wiki": "https://www.wikidata.org/wiki/Property:P885",
            "hyf": "https://www.opengis.net/def/schema/hy_features/hyf/",
            "qudt": "http://qudt.org/schema/qudt/",
            "unit": "http://qudt.org/vocab/unit/"
        }
    ],
    "@id": "{{ data['@id'] }}",
	"@type": [
		"hyf:HY_FlowPath",
		"hyf:HY_WaterBody",
        "schema:Place"
	],
    "schema:name": "{{ data.name_at_outlet }}",
    {% if data.downstream_mainstem_id %}
    "hyf:downstreamWaterbody": {
        "@id": "{{ data.downstream_mainstem_id }}"
    },
    {% endif %}
    {%- if data.outlet_nhdpv2_comid or data.outlet_nhdpv2huc12 %}
    {%- set realizedCatchment = [] %}
    {%- if data.outlet_nhdpv2_comid %}{% set _ = realizedCatchment.append(data.outlet_nhdpv2_comid) %}{% endif %}
    {%- if data.outlet_nhdpv2huc12 %}{% set _ = realizedCatchment.append(data.outlet_nhdpv2huc12) %}{% endif %}
    "hyf:realizedCatchment": [
    {%- for url in realizedCatchment %}
        {"@id": "{{ url }}"}{% if not loop.last %},{% endif %}
    {%- endfor %}
    ],
    {%- endif %}
    {% if data.outlet_drainagearea %}
    "gsp:hasArea": {
        "qudt:unit": "unit:KiloM2",
        "qudt:value": "{{ data.outlet_drainagearea }}"^^xsd:double
    },
    {% endif %}
    {% if data.outlet_drainagearea %}
    "gsp:hasLength": {
        "qudt:unit": "unit:KiloM",
        "qudt:value": "{{ data.lengthkm }}"^^xsd:double
    },
    {% endif %} 
    {% if data.new_mainstemid %}
    "schema:supersededBy": {
        "@id": {{ data.new_mainstemid.replace("'", '"') }},
    }
    {% endif %}
    "gsp:hasGeometry": {{ data['gsp:hasGeometry'] | to_json }}
}
